# ══════════════════════════════════════════════════════════════════════════════
# Production .env — dashboard.speaksy.online/realestate (VK Realty HME)
# Copy: cp .env.speaksy.example .env && chmod 600 .env
# ══════════════════════════════════════════════════════════════════════════════

# ── Dashboard URL prefix ─────────────────────────────────────────────────────
CLIENT_BASE_PATH=/realestate
CLIENT_ID=vk-realty-hme
CLIENT_HTTP_PORT=8001
ENVIRONMENT=production
ALLOWED_ORIGINS=https://dashboard.speaksy.online

# ── LiveKit (Layer 1 — speaksy.online) ───────────────────────────────────────
LIVEKIT_URL=wss://livekit.speaksy.online
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=inbound-voice-demo
OUTBOUND_TRUNK_ID=ST_GVRiRmsFYCiF

# ── LLM + speech (HME: Hindi/Marathi/English) ─────────────────────────────────
GEMINI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.5
STT_PROVIDER=soniox
SONIOX_API_KEY=
SARVAM_API_KEY=

# ── Supabase (client project) ─────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-northeast-2
SUPABASE_BUCKET=call-recordings
SUPABASE_RECORDINGS_BUCKET=call-recordings

# ── Auth (required in production) ─────────────────────────────────────────────
DISABLE_AUTH=false
JWT_SECRET=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
API_SETTINGS_PASSWORD=

# ── Memory / isolation ────────────────────────────────────────────────────────
RE_MEMORY_DIR=/app/data/hermes/vk-realty-hme
DEFAULT_AGENT_ID=fbfc5a97-b7d1-4dec-8e32-98bd1a645f5c

# ── Optional CRM / calendar ───────────────────────────────────────────────────
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CRM_TYPE=twenty
TWENTY_API_URL=
TWENTY_UI_URL=