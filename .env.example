# ══════════════════════════════════════════════════════════════════════════════
# VK Realty Client — Layer 2 environment
# Copy to .env and fill in values. No infrastructure secrets (Redis, SIP, TURN).
# ══════════════════════════════════════════════════════════════════════════════

# ── Shared LiveKit (Layer 1 — speaksy.online) ───────────────────────────────
LIVEKIT_URL=wss://livekit.speaksy.online
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=inbound-voice-demo

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# ── Speech (VK Realty Tinglish / HME) ─────────────────────────────────────────
SARVAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.5
TTS_PROVIDER=cartesia
SONIOX_API_KEY=
STT_PROVIDER=sarvam

# ── Database (client-isolated Supabase project recommended) ───────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-northeast-2
SUPABASE_RECORDINGS_BUCKET=call-recordings
SUPABASE_BUCKET=call-recordings

# ── Auth (set DISABLE_AUTH=false in production) ───────────────────────────────
DISABLE_AUTH=false
JWT_SECRET=change-me-to-a-long-random-string
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-now

# ── Calendar / CRM (optional) ─────────────────────────────────────────────────
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CRM_TYPE=twenty
TWENTY_API_URL=
TWENTY_UI_URL=

# ── Client identity ───────────────────────────────────────────────────────────
CLIENT_ID=vk-realty-hme
CLIENT_BASE_PATH=/realestate
CLIENT_HTTP_PORT=8001
ENVIRONMENT=production
ALLOWED_ORIGINS=https://dashboard.speaksy.online,http://localhost:8001

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=